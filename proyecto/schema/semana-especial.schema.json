{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semana especial (Review / Survival)",
  "description": "Las semanas de integracion no tienen skill ni topic, asi que no encajan en ficha.schema.json. Forzarlas ahi exigiria hacer opcionales casi todos los campos obligatorios y el schema perderia su funcion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_tipo",
    "id",
    "semana",
    "idioma",
    "clase",
    "titulo",
    "consigna",
    "autochequeo",
    "promptCorreccion"
  ],
  "properties": {
    "_tipo": {
      "const": "semana_especial"
    },
    "id": {
      "type": "string",
      "pattern": "^(REVIEW|SURVIVAL)-(EN|DE|ES|FR|IT|PT)-S\\d{1,2}$"
    },
    "semana": {
      "type": "integer",
      "minimum": 1,
      "maximum": 53
    },
    "idioma": {
      "enum": [
        "en",
        "de",
        "es",
        "fr",
        "it",
        "pt"
      ]
    },
    "clase": {
      "enum": [
        "review",
        "survival"
      ]
    },
    "titulo": {
      "type": "string"
    },
    "minutosEstimados": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240
    },
    "consigna": {
      "type": "string"
    },
    "requisitos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "microtareas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autochequeo": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "promptCorreccion": {
      "type": "string"
    }
  }
}