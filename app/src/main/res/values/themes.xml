<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana: solo el fondo (Papel) para que no haya un destello blanco antes de Compose. -->
    <style name="Theme.LenguApp" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_papel</item>
        <item name="android:colorBackground">@color/fondo_papel</item>
    </style>

    <!--
        PANTALLA DE CARGA (androidx.core:core-splashscreen), Ronda V. Fondo SOLIDO #253C52 (`fondo_splash`) en claro y en oscuro, NO
        `fondo_papel` (ver colors.xml: sobre el papel claro la L no se ve). Icono = splash_l (bitmap, lienzo 288 dp, la L a radio 88 de
        96), que el sistema recorta a un circulo de 192 dp: no hay que escalar nada. Estatico a proposito (`AnimatedIcon` acepta un
        drawable fijo; una animacion alarga el arranque).
        NO poner `windowSplashScreenIconBackgroundColor`: cambia el lienzo a 240 con circulo util de 160 y el arte dejaria de entrar.
        Lo que no se puede: el splash del sistema no admite imagen de fondo (solo color solido + icono centrado), y no se puede alternar
        al azar (el tema lo resuelve el sistema antes de que corra una linea de la app: ni activity-alias ni setComponentEnabledSetting).
    -->
    <style name="Theme.LenguApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_l</item>
        <item name="postSplashScreenTheme">@style/Theme.LenguApp</item>
    </style>
</resources>
