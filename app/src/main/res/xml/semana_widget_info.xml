<?xml version="1.0" encoding="utf-8"?>
<!--
    Se actualiza cada 3 horas: alcanza de sobra para un contenido que cambia
    una vez por semana, y evita que el sistema lo despierte sin necesidad.
    Android igual impone un piso de 30 min, no menos.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="10800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_descripcion" />
